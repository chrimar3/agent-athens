{
  "name": "agent-athens",
  "version": "1.0.0",
  "description": "AI-curated cultural events calendar for Athens, Greece",
  "type": "module",
  "scripts": {
    "build": "bun run src/generate-site.ts",
    "dev": "bun run src/generate-site.ts && bun run serve",
    "serve": "bun run --watch src/serve.ts",
    "deploy": "bash scripts/redeploy.sh",
    "test": "bash scripts/run-tests.sh",
    "test:full": "bun run scripts/test-pipeline.ts --full",
    "test:quick": "bun run scripts/test-pipeline.ts --no-scrape",
    "test:unit": "bun test tests/unit",
    "test:db": "bun test tests/database",
    "test:integration": "bun test tests/integration",
    "test:templates": "bun test tests/templates",
    "test:all": "bun test tests/",
    "typecheck": "tsc --noEmit",
    "test:watch": "bun test --watch tests/",
    "test:coverage": "bun test --coverage tests/",
    "fetch-emails": "bun run src/ingest/email-ingestion.ts",
    "scrape-web": "python3 scripts/scrape-all-sites.py",
    "scrape-web-old": "bun run scripts/scrape-websites.ts",
    "fetch-prices": "python3 scripts/fetch-prices.py",
    "update": "./scripts/update-site.sh",
    "daily-update": "./scripts/daily-update.sh"
  },
  "keywords": [
    "athens",
    "events",
    "cultural",
    "ai",
    "agent-first",
    "GEO",
    "SEO"
  ],
  "author": "agent-athens",
  "license": "MIT",
  "devDependencies": {
    "@types/he": "^1.2.3",
    "@types/node": "^26.6.2",
    "bun-types": "^1.4.2",
    "pa11y": "^10.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@google-analytics/data": "^7.1.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/luxon": "^3.7.5",
    "cheerio": "^1.2.0",
    "fuse.js": "^7.5.0",
    "he": "^1.2.0",
    "imap-simple": "^5.1.0",
    "luxon": "^3.7.2",
    "mailparser": "^3.9.28",
    "node-ical": "^0.27.2",
    "puppeteer": "^25.11.0",
    "puppeteer-core": "^25.11.0",
    "satori": "^0.33.4",
    "sharp": "^0.35.4",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "basic-ftp": "^5.3.1",
    "brace-expansion": "^2.1.4",
    "ip-address": "^10.7.2",
    "js-yaml": "^4.3.2",
    "semver": "^7.8.5",
    "ws": "^8.21.0"
  },
  "trustedDependencies": [
    "puppeteer"
  ]
}
