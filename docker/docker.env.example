# Agent Athens container secrets. Copy it to a folder no container mounts
# (not the repo, not ~/.config/agentathens) and lock it down:
#   mkdir -p ~/.config/agentathens-docker && chmod 700 ~/.config/agentathens-docker
#   cp docker/docker.env.example ~/.config/agentathens-docker/docker.env
#   chmod 600 ~/.config/agentathens-docker/docker.env
# docker/aa-run.sh refuses to run if others can read it or if it sits inside a
# mounted folder, and hands each run only the tokens that run needs.
# Plain KEY=value lines — no quotes, no `export`.

# GitHub — fine-grained personal access token, repository access "Only
# chrimar3/agent-athens"; permissions Contents: read/write, Issues: read/write
# (yield canary), Metadata: read. Set an expiry and a calendar reminder.
# https://github.com/settings/personal-access-tokens/new
GH_TOKEN=

# Netlify — personal access token (User settings → Applications → New access
# token). Netlify tokens are account-wide; set an expiry.
NETLIFY_AUTH_TOKEN=
# The site's API ID (Netlify → Site configuration → Site details). Pinned here
# so no container-writable file decides which site gets deployed or checked.
NETLIFY_SITE_ID=

# Claude Code — long-lived subscription token for `claude -p` enrichment.
# Create it on the Mac with:  claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Identity for the pipeline's daily "chore: daily pipeline update" commit.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
GIT_COMMITTER_NAME=
GIT_COMMITTER_EMAIL=

# Email ingestion and geocoding normally come from the repo's .env, which the
# container sees through the repo mount. Set them here only if you move them
# out of .env:
# EMAIL_USER=
# EMAIL_PASSWORD=
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# GOOGLE_GEOCODING_API_KEY=
