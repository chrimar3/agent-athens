61924618f47467&id=ff7c8617f7&e=3e4acd3fb7\" style=\"display:block\" target=\"_blank\" data-block-id=\"140\"><table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"border-collapse:separate;margin:0;vertical-align:top;max-width:100%;width:100%;height:auto\" role=\"presentation\" data-testid=\"image-140\"><tbody><tr><td style=\"border:0;border-radius:0;margin:0\" valign=\"top\"><img alt=\"\" src=\"https://mcusercontent.com/6124860e72661924618f47467/images/cf68045a-0e51-7560-3a6c-f897880b9382.png\" width=\"660\" height=\"auto\" style=\"display:block;max-width:100%;height:auto;border-radius:0\" class=\"imageDropZone mceImage\" /></td></tr></tbody></table></a><div><!--<![endif]--></div><div>\n<!--[if mso]>\n<a href=\"https://issuu.com/megaron.gr/docs/_43a7667fa21b8c?fr=sMDkwZjgzNjAxOTY\"><span class=\"mceImageBorder\" style=\"border:0;border-width:2px;vertical-align:top;margin:0\"><img role=\"presentation\" class=\"imageDropZone mceImage\" src=\"https://mcusercontent.com/6124860e72661924618f47467/images/cf68045a-0e51-7560-3a6c-f897880b9382.png\" alt=\"\" width=\"660\" height=\"auto\" style=\"display:block;max-width:660px;width:660px;height:auto\"/></span></a>\n<![endif]-->\n</div></td></tr><tr><td style=\"padding-top:0;padding-bottom:0;padding-right:0;padding-left:0\" valign=\"top\" class=\"mceGutterContainer\" id=\"gutterContainerId-146\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"border-collapse:separate\" role=\"presentation\"><tbody><tr><td style=\"padding-top:0;padding-bottom:0;padding-right:0;padding-left:0;border:0;border-radius:0\" valign=\"top\" id=\"b146\"><table width=\"100%\" style=\"border:0;background-color:#d4d4d4;border-radius:0;border-collapse:separate\"><tbody><tr><td style=\"padding-left:24px;padding-right:24px;padding-top:0;padding-bottom:12px\" class=\"mceTextBlockContainer\"><div data-block-id=\"146\" class=\"mceText\" id=\"d146\" style=\"width:100%\"><p style=\"text-align: center;\" class=\"last-child\"><span style=\"font-family: 'Helvetica Neue', Helvetica, Arial, Verdana, sans-serif\">Ξεφυλλίστε το πρόγραμμα </span><a href=\"https://megaron.us10.list-manage.com/track/click?u=6124860e72661924618f47467&id=487635e1ab&e=3e4acd3fb7\" target=\"_blank\" style=\"color: #000000;\"><span style=\"font-family: 'Helvetica Neue', Helvetica, Arial, Verdana, sans-serif\">εδώ</span></a></p></div></td></tr></tbody></table></td></tr></tbody></table></td></tr><tr><td style=\"padding-top:0;padding-bottom:0;padding-right:0;padding-left:0\" valign=\"top\" class=\"mceGutterContainer\" id=\"gutterContainerId-113\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"border-collapse:separate\" role=\"presentation\"><tbody><tr><td style=\"padding-top:0;padding-bottom:0;padding-right:0;padding-left:0;border:0;border-radius:0\" valign=\"top\" id=\"b113\"><table width=\"100%\" style=\"border:0;background-color:#d4d4d4;border-radius:0;border-collapse:separate\"><tbody><tr><td style=\"padding-left:24px;padding-right:24px;padding-top:12px;padding-bottom:0\" class=\"mceTextBlockContainer\"><div data-block-id=\"113\" class=\"mceText\" id=\"d113\" style=\"width:100%\"><p style=\"line-height: 1.25; mso-line-height-alt: 125%; text-align: left;\"><span style=\"font-size: 20px\">ΔΡΑΣΕΙΣ ΠΡΟΣΒΑΣΙΜΟΤΗΤΑΣ</span><span style=\"font-size: 24px\"> </span><br /><span style=\"font-size: 15px\"><span style=\"font-family: 'Helvetica Neue', Helvetica, Arial, Verdana, sans-serif\"><span style=\"background-color: rgb(212, 212, 212)\">Στο Μέγαρο Μουσικής Αθηνών ο πολιτισμός είναι ανοιχτός σε όλους. Με γνώμονα την ισότιμη πρόσβαση και την ουσιαστική συμπερίληψη, και μέλημα το σεβασμό στη διαφορετικότητα, σχεδιάζουμε και υλοποιούμε συναυλίες, εκπαιδευτικά προγράμματα και μουσικά δρώμενα που ενθαρρύνουν τη συμμετοχή όλων στην καλλιτεχνική εμπειρία.  Η προσπάθεια αυτή υποστηρίζεται από την Alpha Bank, στο πλαίσιο της πρωτοβουλίας «Πολιτισμός για όλους». </span></span></span></p><p style=\"line-height: 1.25; mso-line-height-alt: 125%;\"><br /></p><p class=\"\" style=\"text-align: left; line-height: 1.25; mso-line-height-alt: 125%;\"><span style=\"font-size: 15px\"><span style=\"font-family: &quot;Helvetica Neue&quot;, Helvetica, Arial, Verdana, sans-serif\"><span style=\"background-color: rgb(212, 212, 212)\">ΧΟΡΗΓΟΣ ΠΡΟΣΒΑΣΙΜΟΤΗΤΑΣ</span></span></span></p><p style=\"text-align: left; line-height: 1.25; mso-line-height-alt: 125%;\"><span style=\"font-size: 15px\"><span style=\"font-family: 'Helvetica Neue', Helvetica, Arial, Verdana, sans-serif\"><span style=\"background-color: rgb(212, 212, 212)\"><img src=\"https://mcusercontent.com/6124860e72661924618f47467/images/c762257f-9fef-a257-9660-fa417ea6dd31.png\" style=\"max-width: 612px; width: 250px; height: auto;\" width=\"250\" height=\"60\" data-proportional=\"true\" /></span></span></span></p><p style=\"text-align: left; line-height: 1.25; mso-line-height-alt: 125%;\"><span style=\"font-size: 15px\"><span style=\"font-family: &quot;Helvetica Neue&quot;, Helvetica, Arial, Verdana, sans-serif\"><span style=\"background-color: rgb(212, 212, 212)\">Tην καλλιτεχνική περίοδο 2025–26 η Alpha Bank είναι χορηγός προσβασιμότητας στις παρακάτω δράσεις, συμβάλλοντας στη διαμόρφωση ενός πολιτιστικού τοπίου ανοιχτού, φιλόξενου, κοντά στις ανάγκες της κοινωνίας. </span></span></span></p><ul><li style=\"line-height: 1.25; mso-line-height-alt: 125%;\"><p style=\"line-height: 1.25; mso-line-height-alt: 125%;\"><span style=\"font-size: 15px\"><span style=\"font-family: &quot;Helvetica Neue&quot;, Helvetica, Arial, Verdana, sans-serif\"><span style=\"background-color: rgb(212, 212, 212)\">Διαδραστικές συναυλίες με γνωστούς καλλιτέχνες, για άτομα με άνοια και τους φροντιστές τους</span></span></span></p></li><li style=\"line-height: 1.25; mso-line-height-alt: 125%;\"><p style=\"line-height: 1.25; mso-line-height-alt: 125%;\"><span style=\"font-size: 15px\"><span style=\"font-family: &quot;Helvetica Neue&quot;, Helvetica, Arial, Verdana, sans-serif\"><span style=\"background-color: rgb(212, 212, 212)\">Συναυλίες συμφωνικής ορχήστρας προσβάσιμες για παιδιά με οπτική, νευροαναπτυξιακή ή/και κινητική αναπηρία</span></span></span></p></li><li style=\"line-height: 1.25; mso-line-height-alt: 125%;\"><p style=\"line-height: 1.25; mso-line-height-alt: 125%;\"><span style=\"font-size: 15px\"><span style=\"font-family: &quot;Helvetica Neue&quot;, Helvetica, Arial, Verdana, sans-serif\"><span style=\"background-color: rgb(212, 212, 212)\">Συμπεριληπτική εκπαίδευση και πολιτιστικές δράσεις για ευάλωτες ομάδες παιδιών με παραστάσεις σε χώρους των Νοσοκομείων Παίδων </span></span></span></p></li><li style=\"line-height: 1.25; mso-line-height-alt: 125%;\"><p style=\"line-height: 1.25; mso-line-height-alt: 125%;\"><a href=\"https://megaron.us10.list-manage.com/track/click?u=6124860e72661924618f47467&id=51a26359da&e=3e4acd3fb7\" target=\"_blank\" style=\"color: #000000;\"><span style=\"font-size: 15px\"><span style=\"font-family: &quot;Helvetica Neue&quot;, Helvetica, Arial, Verdana, sans-serif\"><span style=\"background-color: rgb(212, 212, 212)\">Το πρώτο μου εργαστήριο: Τα χρώματα της μουσικής</span></span></span></a><span style=\"font-size: 15px\"><span style=\"font-family: &quot;Helvetica Neue&quot;, Helvetica, Arial, Verdana, sans-serif\"><span style=\"background-color: rgb(212, 212, 212)\">, για οικογένειες με παιδιά 3-5 ετών με και χωρίς αναπηρία</span></span></span></p></li><li style=\"line-height: 1.25; mso-line-height-alt: 125%;\"><p style=\"line-height: 1.25; mso-line-height-alt: 125%;\"><a href=\"https://megaron.us10.list-manage.com/track/click?u=6124860e72661924618f47467&id=220d5c3fa5&e=3e4acd3fb7\" target=\"_blank\" style=\"color: #000000;\"><span style=\"font-size: 15px\"><span style=\"font-family: &quot;Helvetica Neue&quot;, Helvetica, Arial, Verdana, sans-serif\"><span style=\"background-color: rgb(212, 212, 212)\">Ανακαλύπτοντας τα μουσικά όργανα: Τα όργανα της συμφωνικής ορχήστρας</span></span></span></a><span style=\"font-size: 15px\"><span style=\"font-family: &quot;Helvetica Neue&quot;, Helvetica, Arial, Verdana, sans-serif\"><span style=\"background-color: rgb(212, 212, 212)\">, για οικογένειες με παιδιά από 6 ετών με και χωρίς αναπηρία (δείτε το προσβάσιμο βίντεο παρουσίασης παρακάτω)</span></span></span></p><p style=\"line-height: 1.25; mso-line-height-alt: 125%;\"><br /></p></li></ul><p><span style=\"font-size: 15px\"><span style=\"font-family: &quot;Helvetica Neue&quot;, Helvetica, Arial, Verdana, sans-serif\"><span style=\"background-color: rgb(212, 212, 212)\">Σε συνεργασία με τη liminal </span></span><span style=\"font-family: 'Helvetica Neue', Helvetica, Arial, Verdana, sans-serif\"><span style=\"background-color: rgb(212, 212, 212)\"> </span></span></span></p><p style=\"text-align: center;\" class=\"last-child\"><br /></p></div></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table><!--[if (gte mso 9)|(IE)]></td></tr></table><![endif]--></td></tr></tbody><tbody data-block-id=\"95\" class=\"mceWrapper\"><tr><td style=\"background-color:transparent\" valign=\"top\" align=\"center\" class=\"mceSectionFooter\"><!--[if (gte mso 9)|(IE)]><table align=\"center\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" width=\"660\" style=\"width:660px;\"><tr><td><![endif]--><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"max-width:660px\" role=\"presentation\"><tbody><tr><td style=\"background-color:#ffffff\" valign=\"top\" class=\"mceWrapperInner\"><table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100