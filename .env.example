# Athens Events Agent - Environment Configuration

# Email Configuration (for future email newsletter ingestion)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password-here
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# Google Geocoding API (optional — fallback for Nominatim)
# Get a key: https://console.cloud.google.com/apis/credentials
# Enable: Geocoding API
GOOGLE_GEOCODING_API_KEY=

# Notes:
# - Use Gmail App Passwords (16 characters), not regular password
# - Enable IMAP in Gmail Settings > Forwarding and POP/IMAP
# - Set file permissions: chmod 600 .env
