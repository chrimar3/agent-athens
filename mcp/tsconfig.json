{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["bun-types"],
    "typeRoots": ["../node_modules/@types", "../node_modules"]
  },
  "include": ["src/**/*", "test/**/*", "netlify/**/*"]
}
