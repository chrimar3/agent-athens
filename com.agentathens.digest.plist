<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agentathens.digest</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>d="${AA_STATE_DIR:-$HOME/.config/agentathens-docker}/logs"; mkdir -p "$d" &amp;&amp; exec &gt;&gt;"$d/digest.log" 2&gt;&amp;1 &amp;&amp; cd "/Users/chrism/Project with Claude/AgentAthens/agent-athens" &amp;&amp; exec /Users/chrism/.bun/bin/bun run scripts/weekly-digest.ts</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <!-- Output goes to the host-only state folder (security loop round 4):
         containers can write the repo logs/ folder, so a symlink planted there
         would make launchd or this job write into any file the owner can write. -->
</dict>
</plist>
