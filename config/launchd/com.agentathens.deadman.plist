<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/Users/chrism/.local/bin:/Users/chrism/.npm-global/bin:/Users/chrism/.bun/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>TZ</key>
		<string>Europe/Athens</string>
	</dict>
	<key>KeepAlive</key>
	<false/>
	<key>Label</key>
	<string>com.agentathens.deadman</string>
	<key>Nice</key>
	<integer>5</integer>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-c</string>
		<string>d="${AA_STATE_DIR:-$HOME/.config/agentathens-docker}/logs"; mkdir -p "$d" &amp;&amp; exec &gt;&gt;"$d/deadman-stdout.log" 2&gt;&amp;1 &amp;&amp; exec /Users/chrism/.bun/bin/bun run "/Users/chrism/Project with Claude/AgentAthens/agent-athens/scripts/deadman-watchdog.ts"</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<!-- Output goes to the host-only state folder (security loop round 4):
		 containers can write the repo logs/ folder, so a symlink planted there
		 would make launchd or this job write into any file the owner can write. -->
	<key>StartInterval</key>
	<integer>21600</integer>
	<key>ThrottleInterval</key>
	<integer>300</integer>
	<key>WorkingDirectory</key>
	<string>/Users/chrism/Project with Claude/AgentAthens/agent-athens</string>
</dict>
</plist>
