<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Job identifier -->
    <key>Label</key>
    <string>com.agentathens.enrichment-check</string>

    <!-- Script to run -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/chrism/Project with Claude/AgentAthens/agent-athens/scripts/daily-enrichment-check.sh</string>
    </array>

    <!-- Working directory -->
    <key>WorkingDirectory</key>
    <string>/Users/chrism/Project with Claude/AgentAthens/agent-athens</string>

    <!-- Run daily at 9:00 AM (after the 8 AM scraping pipeline) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Environment variables -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/Users/chrism/.bun/bin</string>
        <key>TZ</key>
        <string>Europe/Athens</string>
    </dict>

    <!-- Logging -->
    <key>StandardOutPath</key>
    <string>/Users/chrism/Project with Claude/AgentAthens/agent-athens/logs/enrichment-check-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/chrism/Project with Claude/AgentAthens/agent-athens/logs/enrichment-check-error.log</string>

    <!-- Don't run at load, wait for schedule -->
    <key>RunAtLoad</key>
    <false/>

    <!-- Retry on failure after 5 minutes -->
    <key>ThrottleInterval</key>
    <integer>300</integer>

    <!-- Keep alive settings -->
    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
