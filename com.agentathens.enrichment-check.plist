<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Job identifier -->
    <key>Label</key>
    <string>com.agentathens.enrichment-check</string>

    <!-- Script to run -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>d="${AA_STATE_DIR:-$HOME/.config/agentathens-docker}/logs"; mkdir -p "$d" &amp;&amp; exec &gt;&gt;"$d/enrichment-check-stdout.log" 2&gt;&amp;1 &amp;&amp; exec /bin/bash "/Users/chrism/Project with Claude/AgentAthens/agent-athens/scripts/daily-enrichment-check.sh"</string>
    </array>

    <!-- Working directory -->
    <key>WorkingDirectory</key>
    <string>/Users/chrism/Project with Claude/AgentAthens/agent-athens</string>

    <!-- Run daily at 9:00 AM (after the 8 AM scraping pipeline) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Environment variables -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/Users/chrism/.bun/bin</string>
        <key>TZ</key>
        <string>Europe/Athens</string>
    </dict>

    <!-- Logging -->
    <!-- Output goes to the host-only state folder (security loop round 4):
         containers can write the repo logs/ folder, so a symlink planted there
         would make launchd or this job write into any file the owner can write. -->

    <!-- Don't run at load, wait for schedule -->
    <key>RunAtLoad</key>
    <false/>

    <!-- Retry on failure after 5 minutes -->
    <key>ThrottleInterval</key>
    <integer>300</integer>

    <!-- Keep alive settings -->
    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
